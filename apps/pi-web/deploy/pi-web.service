[Unit]
Description=Pi Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/abel/omfde/apps/pi-web
ExecStart=/usr/bin/node server.mjs
Environment=PI_WEB_CONFIG=/home/abel/.pi-web/config.json
Environment=NODE_ENV=production
# 可选：仓库内没有全局 pi 时显式指定
# Environment=PI_WEB_PI_BIN=/home/abel/omfde/node_modules/.bin/pi
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
