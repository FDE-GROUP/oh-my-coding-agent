{
	"name": "@omfde/docs-site",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"sync": "node scripts/sync.mjs",
		"dev": "node scripts/sync.mjs && blume dev",
		"build": "node scripts/sync.mjs && blume build",
		"preview": "blume preview",
		"check": "blume doctor && blume validate",
