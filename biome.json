{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"scripts/model-catalog-protocol.ts",
			"scripts/model-catalog-protocol.test.ts",
			"scripts/check-secrets.mjs",
			"scripts/check-tsdoc.mjs",
			"apps/*/src/**/*.ts",
			"apps/*/src/**/*.tsx",
			"apps/*/*.mjs",
			"apps/*/scripts/**/*.mjs",
			"apps/*/bin/**/*.mjs",
			"extensions/*/src/**/*.ts",
			"extensions/*/test/**/*.ts",
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/ai/catalog/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"packages/agent/examples/**/*.ts",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/routeTree.gen.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules"
		]
	},
	"plugins": ["./scripts/biome/model-type-comparison.grit"]
}
